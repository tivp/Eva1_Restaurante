<?xml version="1.0" encoding="utf-8"?>
<!--
    Contenedor principal ConstraintLayout:
    Organiza todas las vistas mediante restricciones horizontales y verticales
    en una jerarquía plana sin anidamientos, optimizando el rendimiento de la interfaz.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".MainActivity">

    <!-- ================================================================== -->
    <!-- ENCABEZADO: LOGOTIPO DEL RESTAURANTE                               -->
    <!-- ================================================================== -->

    <!-- ImageView centrado horizontalmente en la parte superior para el logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="80dp"
        android:scaleType="centerInside"
        android:src="@drawable/logo"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================================================================== -->
    <!-- SECCIÓN 1: PLATILLO "PASTEL DE CHOCLO" ($12.000)                   -->
    <!-- ================================================================== -->

    <!-- Fotografía representativa del Pastel de Choclo ubicada a la izquierda -->
    <ImageView
        android:id="@+id/imgPastel"
        android:layout_width="90dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/pastel"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgLogo" />

    <!-- Nombre del primer platillo alineado a la derecha de su imagen -->
    <TextView
        android:id="@+id/tvTituloPastel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pastel de Choclo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/imgPastel"
        app:layout_constraintTop_toTopOf="@id/imgPastel" />

    <!-- Etiqueta descriptiva "Cant." para el ingreso de unidades de Pastel de Choclo -->
    <TextView
        android:id="@+id/tvCantLabel1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cant."
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/imgPastel"
        app:layout_constraintTop_toBottomOf="@id/tvTituloPastel" />

    <!-- Campo de entrada numérica (inputType="number") para la cantidad de Pastel de Choclo -->
    <EditText
        android:id="@+id/etCantPastel"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="1"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tvCantLabel1"
        app:layout_constraintTop_toTopOf="@id/tvCantLabel1"
        app:layout_constraintBottom_toBottomOf="@id/tvCantLabel1" />

    <!-- Texto dinámico que muestra el subtotal calculado para Pastel de Choclo -->
    <TextView
        android:id="@+id/tvSubtotalPastel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$12.000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvCantLabel1"
        app:layout_constraintTop_toBottomOf="@id/tvCantLabel1" />


    <!-- ================================================================== -->
    <!-- SECCIÓN 2: PLATILLO "CAZUELA" ($10.000)                            -->
    <!-- ================================================================== -->

    <!-- Fotografía representativa de la Cazuela posicionada debajo de la imagen anterior -->
    <ImageView
        android:id="@+id/imgCazuela"
        android:layout_width="90dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/cazuela"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPastel" />

    <!-- Nombre del segundo platillo alineado a la derecha de su imagen -->
    <TextView
        android:id="@+id/tvTituloCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cazuela"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/imgCazuela"
        app:layout_constraintTop_toTopOf="@id/imgCazuela" />

    <!-- Etiqueta descriptiva "Cant." para el ingreso de unidades de Cazuela -->
    <TextView
        android:id="@+id/tvCantLabel2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cant."
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/imgCazuela"
        app:layout_constraintTop_toBottomOf="@id/tvTituloCazuela" />

    <!-- Campo de entrada numérica (inputType="number") para la cantidad de Cazuela -->
    <EditText
        android:id="@+id/etCantCazuela"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:text="1"
        android:gravity="center"
        android:textSize="16sp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/tvCantLabel2"
        app:layout_constraintTop_toTopOf="@id/tvCantLabel2"
        app:layout_constraintBottom_toBottomOf="@id/tvCantLabel2" />

    <!-- Texto dinámico que muestra el subtotal calculado para Cazuela -->
    <TextView
        android:id="@+id/tvSubtotalCazuela"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$10.000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tvCantLabel2"
        app:layout_constraintTop_toBottomOf="@id/tvCantLabel2" />


    <!-- ================================================================== -->
    <!-- SECCIÓN INFERIOR: RESUMEN DE TOTALES Y SWITCH DE PROPINA (10%)     -->
    <!-- ================================================================== -->

    <!-- Etiqueta "Comida" (Total sin propina) anclada sobre el Switch de propina -->
    <TextView
        android:id="@+id/tvComidaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comida"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toTopOf="@id/switchPropina"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Monto total de la comida sin propina alineado al borde derecho -->
    <TextView
        android:id="@+id/tvComidaMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$22.000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvComidaLabel" />

    <!-- Interruptor (Switch) para activar o desactivar opcionalmente el 10% de propina -->
    <Switch
        android:id="@+id/switchPropina"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Propina"
        android:textSize="16sp"
        android:textStyle="bold"
        android:checked="true"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toTopOf="@id/tvTotalLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Monto calculado del 10% de propina alineado horizontalmente con el Switch -->
    <TextView
        android:id="@+id/tvPropinaMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$2.200"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/switchPropina" />

    <!-- Etiqueta "TOTAL" anclada a la parte inferior del contenedor padre -->
    <TextView
        android:id="@+id/tvTotalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginBottom="48dp"
        android:layout_marginStart="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Monto TOTAL final a pagar (Comida + Propina) formateado en CLP -->
    <TextView
        android:id="@+id/tvTotalMonto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$24.200"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginEnd="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTotalLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>